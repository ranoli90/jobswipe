# syntax=docker/dockerfile:1.4
# Multi-stage build for Flutter web app deployment to Fly.io
FROM dart:stable AS build

# Install Flutter SDK
ARG FLUTTER_VERSION=3.19.0
ARG FLUTTER_CHANNEL=stable

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    zip \
    libglu1-mesa \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Clone and install Flutter
RUN git clone https://github.com/flutter/flutter.git /flutter \
    && cd /flutter \
    && git fetch \
    && git checkout $FLUTTER_VERSION \
    && /flutter/bin/flutter config --no-analytics \
    && /flutter/bin/flutter doctor -v

# Set Flutter environment
ENV FLUTTER_HOME=/flutter
ENV PATH=$FLUTTER_HOME/bin:$PATH

# Set working directory
WORKDIR /app

# Copy Flutter configuration files first for better caching
COPY pubspec.* .fvmrc* ./

# Cache pub packages
RUN --mount=type=cache,target=/root/.pub-cache \
    $FLUTTER_HOME/bin/flutter pub get

# Copy source code and build
COPY . .

# Build Flutter web release
RUN --mount=type=cache,target=/root/.pub-cache \
    $FLUTTER_HOME/bin/flutter build web --release

# Production image - minimal nginx alpine for serving static files
FROM nginx:alpine AS runner

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built Flutter web files
COPY --from=build /app/build/web /usr/share/nginx/html

# Copy nginx configuration for Flutter web serving
# This configuration handles SPA routing (index.html for all routes)
RUN printf 'server {\n    listen 80;\n    server_name _;\n    root /usr/share/nginx/html;\n    index index.html;\n\n    # Gzip compression for better performance\n    gzip on;\n    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;\n    gzip_min_length 1000;\n\n    # Cache static assets\n    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n        expires 1y;\n        add_header Cache-Control "public, immutable";\n    }\n\n    # Serve index.html for all routes (SPA support)\n    location / {\n        try_files $uri $uri/ /index.html;\n    }\n\n    # Health check endpoint\n    location /health {\n        access_log off;\n        return 200 "healthy\\n";\n        add_header Content-Type text/plain;\n    }\n}' > /etc/nginx/conf.d/default.conf

# Security hardening
RUN chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/conf.d
RUN chmod 755 /usr/share/nginx/html
RUN chmod 644 /etc/nginx/conf.d/default.conf

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
